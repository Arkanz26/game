# PostgreSQL (owner/migration role). In production the app should connect with a
# login role that is a member of `silika_app` (see drizzle/0001_invariants.sql).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/silika
# Separate database used by integration tests (wiped on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/silika_test

# Session cookie: set to "false" only for local HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Object storage for document files (MinIO on-prem) — used by the document repository module.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=silika-documents
S3_ACCESS_KEY=silika
S3_SECRET_KEY=silika-dev-secret
